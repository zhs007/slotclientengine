{
  "name": "game003v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:deps": "pnpm --filter @slotclientengine/gameloading build && pnpm --filter @slotclientengine/gameloading-ui-simple build && pnpm --filter @slotclientengine/gameframeworks build && pnpm --filter @slotclientengine/rendercore build",
    "generate:resources": "node ../../packages/rendercore/scripts/generate-scene-layout-vite-resources.mjs --manifest assets/minecart2/layout.manifest.json --out apps/game003v2/src/generated/minecart2-layout-resources.generated.ts",
    "check:resources": "node ../../packages/rendercore/scripts/generate-scene-layout-vite-resources.mjs --manifest assets/minecart2/layout.manifest.json --out apps/game003v2/src/generated/minecart2-layout-resources.generated.ts --check",
    "build": "pnpm run generate:resources && pnpm run prepare:deps && vite build",
    "dev": "pnpm run generate:resources && pnpm run prepare:deps && node ../../scripts/run-vite-dev.mjs",
    "test": "pnpm run generate:resources && vitest run",
    "typecheck": "pnpm run generate:resources && pnpm run prepare:deps && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@slotclientengine/gameloading": "workspace:*",
    "@slotclientengine/gameloading-ui-simple": "workspace:*",
    "@slotclientengine/gameframeworks": "workspace:*",
    "@slotclientengine/rendercore": "workspace:*",
    "pixi.js": "^8.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.15.0",
    "happy-dom": "^20.0.10"
  }
}
