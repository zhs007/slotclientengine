{
  "name": "@slotclientengine/rendercore",
  "version": "0.1.0",
  "private": true,
  "description": "Internal PixiJS render core for slotclientengine.",
  "packageManager": "pnpm@10.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./symbol/data": {
      "source": "./src/symbol/data/index.ts",
      "types": "./dist/symbol/data/index.d.ts",
      "import": "./dist/symbol/data/index.js"
    },
    "./symbol/core": {
      "source": "./src/symbol/core/index.ts",
      "types": "./dist/symbol/core/index.d.ts",
      "import": "./dist/symbol/core/index.js"
    },
    "./symbol/editor": {
      "source": "./src/symbol/editor/index.ts",
      "types": "./dist/symbol/editor/index.d.ts",
      "import": "./dist/symbol/editor/index.js"
    },
    "./background": {
      "source": "./src/background/index.ts",
      "types": "./dist/background/index.d.ts",
      "import": "./dist/background/index.js"
    },
    "./reel": {
      "source": "./src/reel/index.ts",
      "types": "./dist/reel/index.d.ts",
      "import": "./dist/reel/index.js"
    },
    "./viewport": {
      "source": "./src/viewport/index.ts",
      "types": "./dist/viewport/index.d.ts",
      "import": "./dist/viewport/index.js"
    },
    "./scene-layout/data": {
      "source": "./src/scene-layout/data/index.ts",
      "types": "./dist/scene-layout/data/index.d.ts",
      "import": "./dist/scene-layout/data/index.js"
    },
    "./scene-layout/core": {
      "source": "./src/scene-layout/core/index.ts",
      "types": "./dist/scene-layout/core/index.d.ts",
      "import": "./dist/scene-layout/core/index.js"
    },
    "./scene-layout/editor": {
      "source": "./src/scene-layout/editor/index.ts",
      "types": "./dist/scene-layout/editor/index.d.ts",
      "import": "./dist/scene-layout/editor/index.js"
    },
    "./image-string/data": {
      "source": "./src/image-string/data/index.ts",
      "types": "./dist/image-string/data/index.d.ts",
      "import": "./dist/image-string/data/index.js"
    },
    "./image-string/core": {
      "source": "./src/image-string/core/index.ts",
      "types": "./dist/image-string/core/index.d.ts",
      "import": "./dist/image-string/core/index.js"
    },
    "./image-string/editor": {
      "source": "./src/image-string/editor/index.ts",
      "types": "./dist/image-string/editor/index.d.ts",
      "import": "./dist/image-string/editor/index.js"
    },
    "./symbol-image-string": {
      "source": "./src/symbol-image-string/index.ts",
      "types": "./dist/symbol-image-string/index.d.ts",
      "import": "./dist/symbol-image-string/index.js"
    },
    "./win-amount": {
      "source": "./src/win-amount/index.ts",
      "types": "./dist/win-amount/index.d.ts",
      "import": "./dist/win-amount/index.js"
    },
    "./popup/data": {
      "source": "./src/popup/data/index.ts",
      "types": "./dist/popup/data/index.d.ts",
      "import": "./dist/popup/data/index.js"
    },
    "./popup/core": {
      "source": "./src/popup/core/index.ts",
      "types": "./dist/popup/core/index.d.ts",
      "import": "./dist/popup/core/index.js"
    },
    "./popup/editor": {
      "source": "./src/popup/editor/index.ts",
      "types": "./dist/popup/editor/index.d.ts",
      "import": "./dist/popup/editor/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepare:deps": "pnpm --filter @slotclientengine/browserartifactio build && pnpm --filter @slotclientengine/editorresource build && pnpm --filter @slotclientengine/logiccore build && pnpm --filter @slotclientengine/pixiani build && pnpm --filter @slotclientengine/vnicore build",
    "build": "pnpm run prepare:deps && tsc -p tsconfig.build.json",
    "benchmark:image-string": "node ./benchmarks/image-string-hot-path.mjs",
    "benchmark:popup": "node ./benchmarks/popup-runtime-hot-path.mjs",
    "benchmark:symbol": "node --expose-gc ./benchmarks/symbol-runtime-hot-path.mjs",
    "benchmark:scene-layout": "node --expose-gc ./benchmarks/scene-layout-runtime-hot-path.mjs",
    "generate:symbol-state-textures": "node ./scripts/generate-symbol-state-textures.mjs",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "typecheck": "pnpm run prepare:deps && tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "~4.3.10",
    "@slotclientengine/browserartifactio": "workspace:*",
    "@slotclientengine/editorresource": "workspace:*",
    "@slotclientengine/logiccore": "workspace:*",
    "@slotclientengine/pixiani": "workspace:*",
    "@slotclientengine/vnicore": "workspace:*",
    "pixi.js": "^8.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.15.0",
    "sharp": "^0.34.4"
  }
}
